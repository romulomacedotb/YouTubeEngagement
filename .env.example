NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
PUBLIC_URL=
DATABASE_URL=file:./dev.db

# Google OAuth 2.0 (Obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Security & Sessions (MANTENHA a mesma TOKEN_ENCRYPTION_KEY ao migrar um dev.db existente!)
SESSION_SECRET=dev-session-secret-change-in-production-min32chars
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BACKUP_SECRET=

# Cloud SQLite Continuous Replication (Litestream + Backblaze B2 ou Cloudflare R2 - Opcional local)
# Ex. Backblaze B2: https://s3.us-east-005.backblazeb2.com (region: us-east-005)
# Ex. Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (region: auto)
LITESTREAM_REPLICA_BUCKET=
LITESTREAM_REPLICA_ENDPOINT=
LITESTREAM_REPLICA_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
